{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run validate:knowledge)",
      "Bash(npm test)",
      "Bash(node scripts/validate-knowledge.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)"
    ]
  }
}
