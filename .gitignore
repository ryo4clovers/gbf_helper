mcp-server/node_modules/
mcp-server/dist/
/draft/

# Claude Code / エージェントのローカル設定（共有するのは .claude/settings.json のみ）
.claude/settings.local.json
.claude/*.lock

# Network Recorder captures: local-only reference data (see captures/README.md).
# Kept on disk for future DB-building reference, never committed.
tools/network-recorder/captures/*
!tools/network-recorder/captures/README.md

# 引き継ぎプロンプトの生成結果(prompts/generate-handoff.mjs の出力)。雛形と
# スクリプトはコミットするが、生成された貼り付け用テキストはコミットしない。
/handoff.txt
/handoff*.txt

# Downloaded thumbnails are local-only, not distributed with the repository.
mcp-server/.cache/

# Knowledge images: retain source manifest, keep downloaded binaries local.
knowledge/_images/cdn/

# Optional public assets; keep metadata and directory placeholders in Git.
knowledge/_image/**/*.jpg
knowledge/_image/**/*.png
knowledge/_image/**/*.part
